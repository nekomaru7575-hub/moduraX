# もじゅらXの環境変数の雛形。値は入れていません。
# 使うときは .env という名前でコピーして、必要なものだけ埋めてください。
#
# 【ローカルで動かすだけなら .env は要りません】
# npm run dev（server/dev-local.js）は、下の外部サービスの設定を意図的に読み飛ばします。
# 部屋のデータは server/rooms/*.json に平文で落ち、画像はデータURLとして保存されます。
# 音源のアップロードだけは使えません（URLでの追加は使えます）。


# =============================================================================
# 部屋データの保存先（本番で必須）
# =============================================================================
# この2つが揃ったときだけ Redis モードになります。片方でも欠けるとローカルの
# ファイル保存（server/rooms/）に落ちます。
# Renderのようなディスクが消えるPaaSで動かす場合、ここを設定しないと再起動のたびに
# 部屋データが消えます。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
# 画像・音源の置き場（Cloudflare R2。任意）
# =============================================================================
# 5つ揃って初めて有効になります。未設定でもアプリは動きますが、
# 音源のアップロードが無効になり、背景画像はデータURLとして部屋データに埋め込まれます。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ブラウザに返す画像・音源URLの基点。バケットの公開ドメイン。
R2_PUBLIC_BASE_URL=


# =============================================================================
# リポジトリに置いていない絵の置き場（任意）
# =============================================================================
# プラグインのスタンプやトランプの絵には、フリー素材やファンキットのように
# 「自分のサイトで使うのはよいが素材として再配布するのは駄目」というものがある。
# リポジトリに入れるとcloneした人全員へ配ることになるので、配信だけここから行う。
# R2の公開ドメインでも、他の静的ホスティングでもよい。
#   この下に trump/ と stamps/<プラグインID>/ を作って置く。
#   例) ASSET_BASE_URL=https://assets.example.com
#       → https://assets.example.com/trump/card_back.png
#       → https://assets.example.com/stamps/STELLA_KNIGHTS/bouquet.png
# 未設定なら、それらの絵は無いものとして動く（スタンプは一覧に出ず、カードは文字で描かれる）。
ASSET_BASE_URL=


# =============================================================================
# 運営用（任意）
# =============================================================================
# 待ち受けポート。未設定なら 8081。
PORT=

# 開発用の合言葉。これで名乗った人は、どの部屋でもGM同等の操作ができます。
# 未設定なら機能ごと無効。既定値は用意していません（空のまま公開して構いません）。
DEVELOPER_PASSPHRASE=

# 同時にアクティブな卓の上限。部屋の総数ではありません。既定 10。
MAX_ACTIVE_ROOMS=
# 最後の1人が切れてから枠を保持する時間（ミリ秒）。既定 3分。
ACTIVE_GRACE_MS=
# WebSocketの同時接続数の上限。既定 200。
MAX_CONNECTIONS=

# アップロード1件あたりの上限（MB）
MAX_AUDIO_MB=
MAX_IMAGE_MB=
# 1部屋あたりのR2使用量の天井（MB）。既定 500。
MAX_ROOM_STORAGE_MB=
# バケット全体の想定枠（MB）。既定 10240。
R2_QUOTA_MB=
# 残量がこれを下回ると新規部屋の作成を止める（MB）。既定 1024。
R2_MIN_FREE_CREATE_MB=
# 残量がこれを下回るとアップロードも止める（MB）。既定 256。
R2_MIN_FREE_UPLOAD_MB=
# 部屋の書き出しに埋め込む画像の上限（MB）
MAX_EXPORT_EMBED_MB=

# BCDiceのシステム情報をサーバー側でキャッシュする日数
BCDICE_CACHE_DAYS=

# 入室音・チャット送信音のURL。空なら音を鳴らす仕組み自体を作りません。
ENTRY_SOUND_URL=
CHAT_SEND_SOUND_URL=

# 重い操作のメモリ予算（server/memory-budget.js）。通常は触りません。
MEMORY_LIMIT_MB=
MEMORY_SAFE_FRACTION=
MEMORY_NON_HEAP_MB=
MAX_HEAVY_OPERATIONS=
HEAVY_QUEUE_MAX=
HEAVY_WAIT_TIMEOUT_MS=

# 1 のときだけ、Redisに無い部屋をローカルの server/rooms/*.json から一度だけ移行します。
# 既定はオフ。削除した部屋が復活する事故が起きたため、明示的に有効にしたときだけ動きます。
MIGRATE_LEGACY_ROOM_FILES=

# 1 のときだけ WebRTC のシグナリング中継を通し、P2Pの卓を作れるようにします。既定はオフ。
# オフのサーバーでは「P2Pで開く」の選択肢そのものが出ません。
#
# **非常停止のスイッチとして使えます。** 切ると、既に作られたP2Pの卓も
# 「控えを最後に預けた時点の、普通の卓」として開きます（誰も入れなくなったりはしません）。
ENABLE_P2P_SIGNALING=
